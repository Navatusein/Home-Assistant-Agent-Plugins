<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>HomeAssistant.Agent.Plugin.Sendspin</AssemblyName>
        <RootNamespace>HomeAssistant.Agent.Plugin.Sendspin</RootNamespace>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <!-- Shown in the agent and in the plugin catalog; see
         HomeAssistant.Agent.Plugin.Sdk/build. -->
    <PropertyGroup>
        <AgentPlugin>true</AgentPlugin>
        <Version>1.0.0</Version>
        <PluginName>Sendspin Plugin</PluginName>
        <PluginDescription>Plays Music Assistant on this computer as a Sendspin player.</PluginDescription>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compile against the logging abstraction, but neither copy nor embed
             it: the host ships it (via HomeAssistant.Agent.Plugin.Base) and the
             plugin's ILogger must resolve to that single shared copy. -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" ExcludeAssets="runtime" />
        <!-- Pinned: a new SDK means a new plugin version (docs/PLAN-sendspin.md
             in the agent repository). 10.x speaks only the encrypted protocol,
             Music Assistant with aiosendspin 10.0.0 or later. -->
        <PackageReference Include="Sendspin.SDK" Version="10.1.0" />
    </ItemGroup>

</Project>
