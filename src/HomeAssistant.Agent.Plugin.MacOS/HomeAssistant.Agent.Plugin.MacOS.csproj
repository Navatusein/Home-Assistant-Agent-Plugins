<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Plain net10.0: the macOS APIs are reached through P/Invoke, so the
             plugin builds anywhere. AssemblyInfo.cs marks it macOS-only, and
             the agent skips it on other systems. -->
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>HomeAssistant.Agent.Plugin.MacOS</AssemblyName>
        <RootNamespace>HomeAssistant.Agent.Plugin.MacOS</RootNamespace>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <!-- Shown in the agent and in the plugin catalog; see
         HomeAssistant.Agent.Plugin.Sdk/build. -->
    <PropertyGroup>
        <AgentPlugin>true</AgentPlugin>
        <Version>1.0.0</Version>
        <PluginName>MacOS Plugin</PluginName>
        <PluginDescription>Volume, audio devices, media, power, launchers, hotkeys and clipboard.</PluginDescription>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compile against the logging abstraction, but neither copy nor embed
             it: the host ships it (via HomeAssistant.Agent.Plugin.Base) and the
             plugin's ILogger must resolve to that single shared copy. -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>
