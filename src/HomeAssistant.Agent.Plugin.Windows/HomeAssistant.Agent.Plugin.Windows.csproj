<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The Windows-versioned TFM pulls in the WinRT projections needed
             for Windows.Media.Control (the "now playing" media session). -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <AssemblyName>HomeAssistant.Agent.Plugin.Windows</AssemblyName>
        <RootNamespace>HomeAssistant.Agent.Plugin.Windows</RootNamespace>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <!-- Shown in the agent and in the plugin catalog; see
         HomeAssistant.Agent.Plugin.Sdk/build. -->
    <PropertyGroup>
        <AgentPlugin>true</AgentPlugin>
        <Version>1.0.1</Version>
        <PluginName>Windows Plugin</PluginName>
        <PluginDescription>Volume, audio devices, media, power, launchers, hotkeys and clipboard.</PluginDescription>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NAudio" Version="2.2.1" />
    </ItemGroup>

</Project>
